<Window x:Class="QuickPalette.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Palette Settings" Width="780" Height="760"
        WindowStartupLocation="CenterScreen" Background="#1E1E22" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B2B31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#25252A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#25252A"/>
            <Setter Property="AlternatingRowBackground" Value="#2B2B31"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#22FFFFFF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="Height" Value="170"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#33333A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#553B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,24,0,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/>

            <TextBlock Text="Global shortcut" Style="{StaticResource H}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Click the box and press the new combination (needs at least one of Ctrl / Alt / Shift). Win+Space is reserved by Windows."/>
            <TextBox x:Name="HotkeyBox" Width="240" HorizontalAlignment="Left" Margin="0,8,0,0"
                     IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown"/>
            <CheckBox x:Name="StartupBox" Content="Start Quick Palette when Windows starts"/>

            <TextBlock Text="Web search bangs" Style="{StaticResource H}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Type the trigger + space as the first word, e.g. “yt lofi”. Put {q} in the URL where the search text goes."/>
            <DataGrid x:Name="BangGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="80"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="URL with {q}" Binding="{Binding Url}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Default bang for the “Search the web” row:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DefaultBangBox" Width="70"/>
            </StackPanel>

            <TextBlock Text="Your commands" Style="{StaticResource H}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Target can be an exe, file, folder or URL. Keywords are extra words that find it (space separated)."/>
            <DataGrid x:Name="CmdGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn Header="Keywords" Binding="{Binding Keywords}" Width="140"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
                    <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Hidden items" Style="{StaticResource H}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Hide anything from the palette with Ctrl+H or right-click. Select an item here to bring it back."/>
            <ListBox x:Name="HiddenList" DisplayMemberPath="Title" Height="110" Margin="0,6,0,0"
                     Background="#25252A" Foreground="White" BorderBrush="#33FFFFFF"/>
            <Button Content="Unhide selected" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Unhide_Click"/>

            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button Content="Save" Background="#3B82F6" Click="Save_Click"/>
                <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="Reload app list" Click="Reload_Click"/>
                <Button Content="Open config folder" Click="Folder_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
