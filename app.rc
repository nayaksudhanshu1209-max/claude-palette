#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Open-source personal project"
            VALUE "FileDescription", "Quick Palette - offline app and file launcher"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "QuickPalette"
            VALUE "OriginalFilename", "QuickPalette.exe"
            VALUE "ProductName", "Quick Palette"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
